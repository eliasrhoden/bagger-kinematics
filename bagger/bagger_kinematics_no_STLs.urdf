<?xml version="1.0" ?>
<robot name="bagger_kinematics_3" xmlns:xacro="http://www.ros.org/wiki/xacro">

  <mujoco>
    <compiler meshdir="meshes/" balanceinertia="true" discardvisual="false"/>
  </mujoco>

<link name="base_link">
  <inertial>
    <origin xyz="0 0 0" rpy="0 0 0"/>
    <mass value="1"/>
    <inertia ixx="1" iyy="1" izz="1" ixy="0.0" iyz="0.0" ixz="0.0"/>
  </inertial>
</link>

<link name="swing_body_1">
  <inertial>
    <origin xyz="0 0 0" rpy="0 0 0"/>
    <mass value="1"/>
    <inertia ixx="1" iyy="1" izz="1" ixy="0.0" iyz="0.0" ixz="0.0"/>
  </inertial>
</link>

<link name="bom_swing_1">
  <inertial>
    <origin xyz="0 0 0" rpy="0 0 0"/>
    <mass value="1"/>
    <inertia ixx="1" iyy="1" izz="1" ixy="0.0" iyz="0.0" ixz="0.0"/>
  </inertial>
</link>

<link name="boom_1">
  <inertial>
    <origin xyz="0 0 0" rpy="0 0 0"/>
    <mass value="1"/>
    <inertia ixx="1" iyy="1" izz="1" ixy="0.0" iyz="0.0" ixz="0.0"/>
  </inertial>
</link>

<link name="stick_1">
  <inertial>
    <origin xyz="0 0 0" rpy="0 0 0"/>
    <mass value="1"/>
    <inertia ixx="1" iyy="1" izz="1" ixy="0.0" iyz="0.0" ixz="0.0"/>
  </inertial>
</link>

<link name="tilt_base_1">
  <inertial>
    <origin xyz="0 0 0" rpy="0 0 0"/>
    <mass value="1"/>
    <inertia ixx="1" iyy="1" izz="1" ixy="0.0" iyz="0.0" ixz="0.0"/>
  </inertial>
</link>

<link name="tilt_1">
  <inertial>
    <origin xyz="0 0 0" rpy="0 0 0"/>
    <mass value="1"/>
    <inertia ixx="1" iyy="1" izz="1" ixy="0.0" iyz="0.0" ixz="0.0"/>
  </inertial>
</link>

<link name="bucket_1">
  <inertial>
    <origin xyz="0 0 0" rpy="0 0 0"/>
    <mass value="1"/>
    <inertia ixx="1" iyy="1" izz="1" ixy="0.0" iyz="0.0" ixz="0.0"/>
  </inertial>
</link>

<joint name="Revolute 1" type="continuous">
  <origin xyz="0.0 0.0 0.0" rpy="1.57 0 0"/>
  <parent link="base_link"/>
  <child link="swing_body_1"/>
  <axis xyz="0.0 1.0 0.0"/>
</joint>

<joint name="Revolute 2" type="continuous">
  <origin xyz="0 0.1 0.950" rpy="0 0 0"/>
  <parent link="swing_body_1"/>
  <child link="bom_swing_1"/>
  <axis xyz="0.0 -1.0 0.0"/>
</joint>

<joint name="Revolute 3" type="continuous">
  <origin xyz="0.135 0.5 0.140" rpy="0 0 0"/>
  <parent link="bom_swing_1"/>
  <child link="boom_1"/>
  <axis xyz="1.0 0.0 0.0"/>
</joint>

<joint name="Revolute 4" type="continuous">
  <origin xyz="0.0 3.310 0.734" rpy="0 0 0"/>
  <parent link="boom_1"/>
  <child link="stick_1"/>
  <axis xyz="1.0 0.0 0.0"/>
</joint>

<joint name="Revolute 5" type="continuous">
  <origin xyz="0.0 1.265 1.164" rpy="0 0 0"/>
  <parent link="stick_1"/>
  <child link="tilt_base_1"/>
  <axis xyz="1.0 0.0 0.0"/>
</joint>

<joint name="Revolute 6" type="continuous">
  <origin xyz="-0.13568 -0.015 0.329722" rpy="0 0 0"/>
  <parent link="tilt_base_1"/>
  <child link="tilt_1"/>
  <axis xyz="-0.0 1.0 0.0"/>
</joint>

<joint name="Revolute 7" type="continuous">
  <origin xyz="0.0 0.15 0.2" rpy="0 0 0"/>
  <parent link="tilt_1"/>
  <child link="bucket_1"/>
  <axis xyz="-0.0 -0.0 1.0"/>
</joint>

</robot>
